# ============================================
# LIVRETA — Variáveis de Ambiente
# Copie para .env.local e preencha os valores
# ============================================

# Supabase (obrigatório)
NEXT_PUBLIC_SUPABASE_URL=https://xxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...

# Domínio do site
NEXT_PUBLIC_DOMAIN=https://autonexabrasil.com.br

# VAPID keys para Web Push (opcional — gerar em https://web-push-codelab.glitch.me/)
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_CONTACT=mailto:email@exemplo.com

# OpenAI (obrigatório para AI Agent)
OPENAI_API_KEY=sk-proj-xxxxx

# Google OAuth (obrigatório para Google Calendar)
GOOGLE_CLIENT_ID=xxxxx.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-xxxxx
GOOGLE_REDIRECT_URI=https://autonexabrasil.com.br/api/google/callback

# Meta (Facebook/Instagram) — obrigatório para Messenger e Instagram DM
META_APP_ID=
META_APP_SECRET=

# Evolution API — configuração padrão (opcional, cada instância pode ter sua própria URL)
DEFAULT_EVOLUTION_API_URL=

# Cloudflare (obrigatório para domínios personalizados)
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ZONE_ID=

# Notificações Push
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_CONTACT=mailto:email@exemplo.com
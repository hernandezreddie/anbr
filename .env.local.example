# ============================================
# AN.BR — Variáveis de Ambiente
# Copie para .env.local e preencha os valores
# ============================================

# Supabase (obrigatório)
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJxxxx
SUPABASE_SERVICE_ROLE_KEY=eyJxxxx

# Domínio do site
NEXT_PUBLIC_DOMAIN=https://autonexabrasil.com.br

# VAPID keys para Web Push (gerar em https://web-push-codelab.glitch.me/)
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_CONTACT=mailto:email@exemplo.com

# OpenAI (obrigatório para AI Agent)
OPENAI_API_KEY=sk-proj-xxxxx

# OpenRouter (opcional) — modelos "provedor/modelo" (ex: deepseek/deepseek-chat)
OPENROUTER_API_KEY=sk-or-v1-xxxxx

# Anthropic (opcional) — modelos Claude
ANTHROPIC_API_KEY=sk-ant-xxxxx

# Google AI (opcional) — modelos Gemini
GEMINI_API_KEY=AIza-xxxxx

# Google OAuth (obrigatório para Google Calendar)
GOOGLE_CLIENT_ID=xxxxx.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-xxxxx
GOOGLE_REDIRECT_URI=https://autonexabrasil.com.br/api/google/callback

# Meta (Facebook/Instagram) — obrigatório para Messenger e Instagram DM
META_APP_ID=
META_APP_SECRET=
META_REDIRECT_URI=https://autonexabrasil.com.br/api/meta/callback
META_WEBHOOK_VERIFY_TOKEN=

# Evolution API — configuração padrão (opcional, cada instância pode ter sua própria URL)
DEFAULT_EVOLUTION_API_URL=

# WhatsApp Cloud API (Meta)
WHATSAPP_ACCESS_TOKEN=
# Token de verificação do webhook (obrigatório se usar Cloud API)
WHATSAPP_WEBHOOK_VERIFY_TOKEN=

# Cron de lembretes (proteger endpoint /api/agendamentos/lembretes)
CRON_SECRET=

# Cloudflare (obrigatório para domínios personalizados)
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ZONE_ID=

# Mercado Pago (Fase 5 — pagamentos PIX automáticos)
# TEST-xxxx (sandbox) ou APP_USR-xxxx (produção)
MERCADOPAGO_ACCESS_TOKEN=
# Secret del webhook: Dashboard MP → Webhooks → crear webhook para /api/webhooks/mercadopago
# y copiar el "Webhook Secret" generado
MERCADOPAGO_WEBHOOK_SECRET=
